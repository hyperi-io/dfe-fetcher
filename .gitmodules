[submodule "ci"]
	path = ci
	url = https://github.com/hyperi-io/ci.git
	fetchRecurseSubmodules = true
	update = rebase
[submodule "schemas"]
	path = schemas
	url = https://github.com/hyperi-io/dfe-schemas.git
[submodule "hyperi-ai"]
	path = hyperi-ai
	url = https://github.com/hyperi-io/hyperi-ai.git
	update = rebase
	fetchRecurseSubmodules = true
